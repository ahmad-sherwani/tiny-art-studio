# Tiny Art Studio Environment Variables
# Copy this file to .env.local for local development or set in Vercel Dashboard

# Stripe Online Payment Gateway Keys (Optional for live Stripe API)
VITE_STRIPE_PUBLIC_KEY=pk_test_51MockKeyForTinyArtStudio1234567890

# Razorpay Online Payment Gateway Keys (Optional for live Razorpay API)
VITE_RAZORPAY_KEY_ID=rzp_test_MockKeyForTinyArtStudio

# Default App Title
VITE_APP_NAME="Tiny Art Studio"
